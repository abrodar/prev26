typ i = int
typ c = char
typ b = bool
typ pi = ^i
typ pb = ^b

var counter : i
var flag : b
var result : i

fun ext_print(x : i) : i
fun ext_read() : i

fun is_zero(n : i) : b =
    n == 0

fun is_even(n : i) : b =
    n % 2 == 0

fun abs_val(n : i) : i =
	let
		var ret : i
	in
	    if n < 0 then
		ret = 0 - n
	    else
		ret = n
	    end,
		ret
	end

fun max(a : i, b : i) : i =
	let
		var ret : i
	in
	    if a > b then
		ret = a
	    else
		ret = b
	    end,
		ret
	end

fun min(a : i, b : i) : i =
	let
		var ret : i
	in
	    if a < b then
		ret = a
	    else
		ret = b
	    end,
		ret
	end

fun pow(base : i, exp : i) : i =
	let
		var ret : i
	in
	    if is_zero(exp) then
		ret = 1
	    else
		ret = base * pow(base, exp - 1)
	    end,
		ret
	end

fun gcd(a : i, b : i) : i =
	let
		var ret : i
	in
	    if is_zero(b) then
		ret = a
	    else
		ret = gcd(b, a % b)
	    end,
		ret
	end

fun fib(n : i) : i =
	let
		var ret : i
	in
	    if n == 0 then
		ret = 0
	    else
		if n == 1 then
		    ret = 1
		else
		    ret = fib(n - 1) + fib(n - 2)
		end
	    end,
		ret
	end

fun sum_to(n : i) : i =
	let
		var ret : i
	in
	    if is_zero(n) then
		ret = 0
	    else
		ret = n + sum_to(n - 1)
	    end,
		ret
	end

fun collatz(n : i) : i =
	let
		var ret : i
	in
	    if n == 1 then
		ret = 0
	    else
		if is_even(n) then
		    ret = 1 + collatz(n / 2)
		else
		    ret = 1 + collatz(3 * n + 1)
		end
	    end,
		ret
	end

fun ackermann(m : i, n : i) : i =
	let
		var ret : i
	in
	    if is_zero(m) then
		ret = n + 1
	    else
		if is_zero(n) then
		    ret = ackermann(m - 1, 1)
		else
		    ret = ackermann(m - 1, ackermann(m, n - 1))
		end
	    end,
		ret
	end

fun digit_sum(n : i) : i =
	let
		var ret : i
	in
	    if n < 10 then
		ret = n
	    else
		ret = n % 10 + digit_sum(n / 10)
	    end,
		ret
	end

fun is_palindrome(n : i, rev : i) : b =
	let
		var ret : b
	in
	    if is_zero(n) then
		ret = n == rev
	    else
		ret = is_palindrome(n / 10, rev * 10 + n % 10)
	    end,
		ret
	end

fun count_bits(n : i) : i =
	let
		var ret : i
	in
	    if is_zero(n) then
		ret = 0
	    else
		ret = n % 2 + count_bits(n / 2)
	    end,
		ret
	end

fun main() : int =
    let
        var a : i
        var bb : i
        var cc : i
        var dd : i
        var e : i
        var f : b
        var g : b
        typ li = i
        typ lb = b
        fun local_max(x : li, y : li) : li =
		let
			var ret : li
		in
		    if x > y then
			ret = x
		    else
			ret = y
		    end,
			ret
		end
        fun local_and(x : lb, y : lb) : lb =
            x and y
        fun triple(x : li) : li =
            x * 3
        fun compose(x : li) : li =
            triple(triple(x))
    in
        counter = 0,
        result = 0,
        flag = true,
        a = fib(10),
        bb = pow(2, 8),
        cc = gcd(bb, a),
        dd = sum_to(100),
        e = collatz(27),
        f = is_even(a),
        g = is_palindrome(12321, 0),
        result = local_max(a, bb),
        result = compose(result),
        counter = ackermann(3, 2),
        let
            var shadow_a : i
            var shadow_b : i
            var shadow_f : b
            var counter : i
            var result : i
            fun shadow_fib(n : i) : i =
		let
			var ret : i
		in
			if n == 0 then
			    ret = 0
			else
			    if n == 1 then
				ret = 1
			    else
				ret = shadow_fib(n - 1) + shadow_fib(n - 2)
			    end
			end,
			ret
		end
            fun accumulate(n : i, acc : i) : i =
		let
			var ret : i
		in
			if is_zero(n) then
			    ret = acc
			else
			    ret = accumulate(n - 1, acc + n)
			end,
			ret
		end
        in
            shadow_a = shadow_fib(15),
            shadow_b = accumulate(50, 0),
            shadow_f = local_and(f, g),
            counter = digit_sum(shadow_a * shadow_b),
            result = min(shadow_a, shadow_b),
            while counter > 0 do
                if is_even(counter) then
                    result = result + shadow_fib(counter)
                else
                    result = result - digit_sum(counter)
                end,
                counter = counter - 1
            end,
            let
                var deep1 : i
                var deep2 : i
                var deep3 : b
                var deep4 : i
                typ di = i
                fun deep_pow(b : di, e : di) : di =
			let
				var ret : di
			in
			    if is_zero(e) then
				ret = 1
			    else
				ret = b * deep_pow(b, e - 1)
			    end,
				ret
			end
                fun deep_collatz(n : di) : di =
			let
				var ret : di
			in
			    if n == 1 then
				ret = 0
			    else
				if is_even(n) then
				    ret = 1 + deep_collatz(n / 2)
				else
				    ret = 1 + deep_collatz(3 * n + 1)
				end
			    end,
				ret
			end
                fun toggle(x : lb) : lb =
			let
				var ret : lb
			in
			    if x then
				ret = false
			    else
				ret = true
			    end,
				ret
			end
            in
                deep1 = deep_pow(2, counter % 10),
                deep2 = deep_collatz(abs_val(result) + 1),
                deep3 = toggle(shadow_f),
                deep4 = max(deep1, deep2),
                flag = local_and(deep3, is_even(deep4)),
                while deep4 > 0 do
                    if is_even(deep4) then
                        if deep4 > 100 then
                            deep4 = deep4 / 2
                        else
                            deep4 = deep4 - 1
                        end
                    else
                        if is_zero(deep4 % 3) then
                            deep4 = deep4 - 3
                        else
                            deep4 = deep4 * 2 - deep4 - 1
                        end
                    end
                end,
                let
                    var ultra1 : i
                    var ultra2 : b
                    var ultra3 : i
                    fun ultra_gcd(a : i, b : i) : i =
			let
				var ret : i
			in
				if is_zero(b) then
				    ret = a
				else
				    ret = ultra_gcd(b, a % b)
				end,
				ret
			end
                    fun ultra_sum(n : i) : i =
			let
				var ret : i
			in
				if is_zero(n) then
				    ret = 0
				else
				    ret = n + ultra_sum(n - 1)
				end,
				ret
			end
                    fun ultra_bits(n : i) : i =
			let
				var ret : i
			in
				if is_zero(n) then
				    ret = 0
				else
				    ret = n % 2 + ultra_bits(n / 2)
				end,
				ret
			end
                in
                    ultra1 = ultra_gcd(deep1, deep2),
                    ultra2 = is_even(ultra1),
                    ultra3 = ultra_sum(ultra_bits(deep4 + ultra1)),
                    counter = ultra3 + count_bits(ultra1),
                    result = ext_print(counter),
                    flag = local_and(ultra2, deep3),
                    while ultra3 > 0 do
                        ultra1 = ultra_gcd(ultra3, ultra1 + 1),
                        ultra3 = ultra3 - 1
                    end,
                    ext_print(result),
                    ultra3
                end
            end
        end
    end
