fun putint(i:int):void
fun getint():int
fun putchar(c:char):void
fun getchar():char
fun exit():void

fun main():int =
    let
        var i:int
        var c:char
    in
        putint(42),
        putchar('\x0A'),
        putchar('A'),
        putchar('\x0A'),
        i = getint(),
        putint(i),
        putchar('\x0A'),
        c = getchar(),
        putchar(c),
        putchar('\x0A'),
        exit(),
        0
    end