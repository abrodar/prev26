fun putint(i:int):void
fun putchar(c:char):void
fun new(size:int):^int
fun del(ptr:^int):void

fun main():int =
    let
        var p:^int
        var q:^int
    in
        p = new(8),
        putint(p as int),
        putchar('\x0A'),
        p^ = 42,
        putint(p^),
        putchar('\x0A'),
        q = new(8),
        putint(q as int),
        putchar(10 as char),
        q^ = 99,
        putint(q^),
        putchar('\x0A'),
        del(p),
        del(q),
        0
    end