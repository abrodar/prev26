fun putint(i:int):void
fun putchar(c:char):void

typ shell = int

typ f = (:shell:int)
typ g = (:int:int)

fun ff(a:int):int=1
fun gg(b:int):int=10

fun main():int= let
                    var real :f
                    var funn :g
                in
                    real = ff,
                    funn = gg,
                    putint(real(5)),
                    putchar(' '),
                    putint(funn(4))
                end
                ,
                300