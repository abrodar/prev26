fun main():int=
    let
        var a:int var b:int var c:int
    in
        a=1, b=2, c=3,
        let
            var x:int var y:int var z:int
            var p:int var q:int var r:int
            var s:int var t:int var u:int
            var v:int var w:int
        in
            x=a+b, y=b+c, z=a+c,
            p=x+y, q=y+z, r=x+z,
            s=p+q, t=q+r, u=p+r,
            v=s+t, w=t+u,
            v+w+s+t+u+p+q+r+x+y+z
        end
    end